{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!.research/**"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "asNeeded"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": { "enabled": false },
  "overrides": [
    {
      "includes": [
        "src/minim/signals/values/**",
        "src/minim/signals/anim.ts",
        "src/minim/signals/_test/extensibility.test.ts",
        "src/minim/signals/_proto-*/**"
      ],
      "formatter": { "enabled": false },
      "assist": { "actions": { "source": { "organizeImports": "off" } } }
    }
  ]
}
